# Template for .env. Copy this file to .env and fill in the values.
# .env is never committed: .gitignore skips it and the git hooks block it.
# On GitHub Actions, set the same names as repository secrets instead.

# Google Analytics: the whole JSON key file of the service account, on one
# line, between single quotes. The account needs the Viewer role on the
# property. Make a key in Google Cloud Console: IAM and admin, Service
# accounts, the account, Keys, Add key, JSON.
BIJLEX_GA_KEY_JSON=''

# Microsoft Clarity: Data Export API token, between single quotes.
# Make one in Clarity: Instellingen, Gegevensexport.
BIJLEX_CLARITY_TOKEN=''
